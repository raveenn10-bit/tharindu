# Supabase Project Configuration for Tilnogz Photography
# Copy to .env and fill in your own values. Never commit .env.
# Find these under: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Optional: override the storage bucket / table names created by
# supabase-schema.sql. Defaults are tilnogz-media and albums.
# VITE_SUPABASE_BUCKET=tilnogz-media
# VITE_SUPABASE_ALBUMS_TABLE=albums

# Optional convenience gate for the admin UI.
# WARNING: anything prefixed VITE_ is bundled into the public JavaScript and is
# readable by anyone. This is NOT a security boundary - it only hides the admin
# panel from casual visitors. Real protection comes from Supabase Auth + RLS.
# Leave unset to require Supabase email/password login.
# VITE_ADMIN_PASSCODE=

# Canonical site origin, no trailing slash (e.g. https://www.tilnogzphotography.com.lk).
# Drives the canonical tag, Open Graph URLs, JSON-LD, robots.txt and sitemap.xml.
VITE_SITE_URL=https://www.tilnogzphotography.com.lk
